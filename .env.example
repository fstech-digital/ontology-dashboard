# =============================================================================
# Ontology Dashboard — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys.
# Only DASHBOARD_ANTHROPIC_KEY is required. All others are optional.

# --- Required ---
DASHBOARD_ANTHROPIC_KEY=sk-ant-api03-your-key-here

# --- Optional LLM providers ---
# DASHBOARD_GOOGLE_KEY=AIza...
# DASHBOARD_OPENAI_KEY=sk-...
# DASHBOARD_MOONSHOT_KEY=sk-...
# DASHBOARD_XAI_KEY=xai-...
# DASHBOARD_INCEPTION_KEY=sk_...
# DASHBOARD_OPENROUTER_KEY=sk-or-v1-...

# --- Authentication (optional) ---
# If set, the dashboard requires login. If not set, no auth required.
# DASHBOARD_USER=admin
# DASHBOARD_PASS=your-password
# DASHBOARD_SECRET=random-jwt-secret-at-least-32-chars

# --- Workspace path (optional) ---
# Override the ontology workspace root. Defaults to parent directory of dashboard.
# ONTOLOGY_PATH=/path/to/your/ontology
